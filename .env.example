# No secrets belong in Vite variables. Empty allows pnpm dev preview only; a production build cannot start.
VITE_API_ORIGIN=
# Immutable synthetic release matching this bundled questionnaire.
VITE_STUDY_RELEASE=

# For a reviewed Pages gateway: VITE_API_ORIGIN=same-origin
# Runtime Pages bindings (not VITE_*): MPC_GATEWAY_ENABLED=synthetic, MPC_FRONTEND_ORIGIN=https://listening.bdim.es

# Staging-only New test button; also requires the exact staging origin and a demo release.
VITE_ENABLE_TEST_RESTART=false
